{
  "name": "career-copilot-daily-pipeline",
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "Asia/Kolkata"
  },
  "tasks": [
    {
      "task_key": "ingest_resume",
      "notebook_task": {
        "notebook_path": "/Repos/career-copilot/databricks/notebooks/01_ingest_resume",
        "base_parameters": {
          "input_path": "dbfs:/tmp/career_copilot/resume_payloads"
        }
      }
    },
    {
      "task_key": "build_silver_skills",
      "depends_on": [{ "task_key": "ingest_resume" }],
      "notebook_task": {
        "notebook_path": "/Repos/career-copilot/databricks/notebooks/02_build_silver_skills"
      }
    },
    {
      "task_key": "build_gold_features",
      "depends_on": [{ "task_key": "build_silver_skills" }],
      "notebook_task": {
        "notebook_path": "/Repos/career-copilot/databricks/notebooks/03_build_gold_features"
      }
    }
  ]
}
